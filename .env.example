# Execution mode: mock or real
ADLC_MODE=mock

# Optional deterministic stage behavior.
# Arrays are consumed in order for repeated stage calls.
# Example: testing fails once, then passes.
ADLC_MOCK_SCRIPT={"testing":["fail","pass"]}

# Mock webhook HMAC secret. Change this in deployed environments.
ADLC_WEBHOOK_SECRET=demo-secret

# Real mode PostgreSQL connection. Optional locally; omit to use memory checkpoints.
ADLC_POSTGRES_DSN=

# Real-mode integration environment variables
ADLC_JIRA_TOKEN=
ADLC_GITHUB_TOKEN=

# Optional server settings
ADLC_HOST=127.0.0.1
ADLC_PORT=8080
